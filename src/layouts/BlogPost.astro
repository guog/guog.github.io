---
import { type CollectionEntry, render } from 'astro:content'
import SectionLinks from '../components/blog/SectionLinks.astro'
import { articleStructuredData, safeJSON } from '../utils/reading'
import ReadWithAgent from '../components/blog/ReadWithAgent.astro'
import Masthead from '../components/blog/Masthead.astro'
import TOC from '../components/blog/TOC.astro'
import Giscus from '../components/Giscus.astro'
import Base from './Base.astro'
interface Props {
  post: CollectionEntry<'blog'>
}
const { post } = Astro.props
const { headings } = await render(post)
---

<Base
  {...post.data}
  author={
    post.data.contentKind === 'translation'
      ? (post.data.source?.author?.name ?? null)
      : post.data.author?.name
  }
>
  <script
    slot='head'
    type='application/ld+json'
    set:html={safeJSON(articleStructuredData(post.id, post.data))}
  />
  <article
    class='grow break-words'
    data-pagefind-body
  >
    <div
      id='blog-hero'
      class='mb-12'
    >
      <Masthead post={post} />
      <ReadWithAgent post={post} />
    </div>
    <div class='flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between'>
      {headings.some((heading) => heading.depth >= 2 && heading.depth <= 4) && (
        <TOC headings={headings} />
      )}
      <div
        data-article-body
        class='prose prose-sm prose-headings:font-semibold prose-headings:text-accent-2 min-w-0'
      >
        <slot />
      </div>
    </div>
  </article>
  <Giscus />
  <SectionLinks />
  <button
    class='hover:border-link fixed end-4 bottom-8 z-90 flex h-10 w-10 translate-y-28 items-center justify-center rounded-full border-2 border-transparent bg-zinc-200 text-3xl opacity-0 transition-all duration-300 data-[show=true]:translate-y-0 data-[show=true]:opacity-100 sm:end-8 sm:h-12 sm:w-12 dark:bg-zinc-700'
    data-show='false'
    id='to-top-btn'
    aria-label='Back to top'
    inert
  >
    <svg
      aria-hidden='true'
      class='h-6 w-6'
      fill='none'
      stroke='currentColor'
      stroke-width='2'
      viewBox='0 0 24 24'
    >
      <path
        d='m4.5 15.75 7.5-7.5 7.5 7.5'
        stroke-linecap='round'
        stroke-linejoin='round'
      />
    </svg>
  </button>
</Base>
<script>
  const button = document.getElementById('to-top-btn')!
  const hero = document.getElementById('blog-hero')!
  button.addEventListener('click', () => {
    document.documentElement.scrollTo({
      top: 0,
      behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
    })
  })
  new IntersectionObserver((entries) => {
    const show = !entries[0]!.isIntersecting
    button.dataset.show = String(show)
    button.inert = !show
  }).observe(hero)
</script>
