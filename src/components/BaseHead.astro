---
import { siteConfig } from '../site.config'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  pubDate?: Date
  updatedDate?: Date
  ogImage?: string
  noindex?: boolean
}
const {
  title,
  description = siteConfig.description,
  pubDate,
  updatedDate,
  ogImage,
  noindex,
} = Astro.props
const pageTitle = title ? `${title} · ${siteConfig.title}` : siteConfig.title
const canonicalURL = new URL(
  Astro.url.pathname === '/404/' ? '/404.html' : Astro.url.pathname,
  siteConfig.url,
)
const imageURL = ogImage ? new URL(ogImage, siteConfig.url).href : undefined
---

<meta charset='utf-8' />
<meta
  name='viewport'
  content='width=device-width, initial-scale=1'
/>
<title>{pageTitle}</title>
<meta
  name='description'
  content={description}
/>
<meta
  name='author'
  content={siteConfig.author}
/>
<meta
  name='generator'
  content={Astro.generator}
/>
{noindex && (
  <meta
    name='robots'
    content='noindex'
  />
)}
<link
  rel='icon'
  type='image/png'
  href='/favicon-96x96.png?v=20261022'
  sizes='96x96'
/>
<link
  rel='icon'
  type='image/svg+xml'
  href='/favicon.svg?v=20261022'
/>
<link
  rel='shortcut icon'
  href='/favicon.ico?v=20261022'
/>
<link
  rel='apple-touch-icon'
  sizes='180x180'
  href='/apple-touch-icon.png?v=20261022'
/>
<meta
  name='apple-mobile-web-app-title'
  content={siteConfig.title}
/>
<link
  rel='manifest'
  href='/site.webmanifest?v=20261022'
/>
<link
  rel='canonical'
  href={canonicalURL}
/>
<link
  rel='sitemap'
  href='/sitemap-index.xml'
/>
<link
  rel='alternate'
  type='application/rss+xml'
  title={siteConfig.title}
  href={`${siteConfig.url}/rss.xml`}
/>
<meta
  property='og:type'
  content={pubDate ? 'article' : 'website'}
/>
<meta
  property='og:url'
  content={canonicalURL}
/>
<meta
  property='og:title'
  content={pageTitle}
/>
<meta
  property='og:description'
  content={description}
/>
<meta
  property='og:site_name'
  content={siteConfig.title}
/>
<meta
  property='og:locale'
  content={siteConfig.ogLocale}
/>
{imageURL && (
  <meta
    property='og:image'
    content={imageURL}
  />
)}
{pubDate && (
  <meta
    property='article:published_time'
    content={pubDate.toISOString()}
  />
)}
{updatedDate && (
  <meta
    property='article:modified_time'
    content={updatedDate.toISOString()}
  />
)}
<meta
  name='twitter:card'
  content={imageURL ? 'summary_large_image' : 'summary'}
/>
<meta
  name='twitter:title'
  content={pageTitle}
/>
<meta
  name='twitter:description'
  content={description}
/>
{imageURL && (
  <meta
    name='twitter:image'
    content={imageURL}
  />
)}
