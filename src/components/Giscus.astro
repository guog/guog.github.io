---
import { giscusConfig } from '../site.config'
---

<section
  class='comments'
  aria-label='Comments'
  data-pagefind-ignore
>
  <h2 class='title'>Comments</h2>
  <div
    class='giscus'
    data-repo={giscusConfig.repo}
    data-mapping={giscusConfig.mapping}
  ></div>
  <noscript>Enable JavaScript to view Giscus comments.</noscript>
</section>
<script
  is:inline
  define:vars={{ config: giscusConfig }}
>
  ;(() => {
    const container = document.querySelector('.giscus')
    if (!container) return
    const getTheme = () => (document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light')
    const script = document.createElement('script')
    script.src = 'https://giscus.app/client.js'
    script.async = true
    script.crossOrigin = 'anonymous'
    const attrs = {
      repo: config.repo,
      'repo-id': config.repoId,
      category: config.category,
      'category-id': config.categoryId,
      mapping: config.mapping,
      strict: '0',
      'reactions-enabled': '1',
      'emit-metadata': '0',
      'input-position': 'top',
      theme: getTheme(),
      lang: config.lang,
    }
    for (const [key, value] of Object.entries(attrs)) script.setAttribute(`data-${key}`, value)
    container.appendChild(script)
    function sync() {
      const theme = getTheme()
      container.dataset.theme = theme
      script.setAttribute('data-theme', theme)
      container
        .querySelector('iframe')
        ?.contentWindow?.postMessage({ giscus: { setConfig: { theme } } }, 'https://giscus.app')
    }
    document.addEventListener('theme-changed', sync)
    new MutationObserver(() => {
      const frame = container.querySelector('iframe')
      if (frame) frame.addEventListener('load', sync, { once: true })
      sync()
    }).observe(container, { childList: true })
    sync()
  })()
</script>
