---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import { getReadingMinutes } from '../../utils/blog'
import FormattedDate from '../FormattedDate.astro'

interface Props {
  post: CollectionEntry<'blog'>
}
const { post } = Astro.props
const { data } = post
---

<header class='post-header'>
  {data.coverImage && (
    <Image
      src={data.coverImage.src}
      alt={data.coverImage.alt}
      width={736}
      loading='eager'
    />
  )}
  <p
    class='eyebrow'
    data-pagefind-filter='分类'
  >
    {data.category}
  </p>
  <h1 data-pagefind-meta='title'>{data.title}</h1>
  <div class='post-meta'>
    <FormattedDate date={data.pubDate} /> · 约 {getReadingMinutes(post.body)} 分钟阅读
    {data.updatedDate && (
      <span>
        {' '}
        · 更新于 <FormattedDate date={data.updatedDate} />
      </span>
    )}
  </div>
  <p
    class='post-description'
    data-pagefind-meta='description'
  >
    {data.description}
  </p>
  <ul
    class='tags'
    aria-label='文章标签'
  >
    {data.tags.map((tag) => (
      <li data-pagefind-filter={`标签:${tag}`}>#{tag}</li>
    ))}
  </ul>
</header>
