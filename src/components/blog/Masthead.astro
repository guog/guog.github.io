---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import { getReadingMinutes, getTagUrl } from '../../utils/blog'
import FormattedDate from '../FormattedDate.astro'
interface Props {
  post: CollectionEntry<'blog'>
}
const { post } = Astro.props
const { data } = post
---

{data.coverImage && (
  <div class='mb-6 aspect-video'>
    <Image
      src={data.coverImage.src}
      alt={data.coverImage.alt}
      layout='constrained'
      width={748}
      height={420}
      loading='eager'
    />
  </div>
)}
<h1
  class='title'
  data-pagefind-meta='title'
>
  {data.title}
</h1>
<p
  class='mt-3'
  data-attribution
>
  {data.contentKind === 'translation' ? (
    <>
      Translated by {data.translator?.name ?? 'not specified'}
      {data.source && (
        <>
          {' '}
          · Original article:{' '}
          <a
            class='cactus-link'
            href={data.source.url}
          >
            {data.source.title}
          </a>
          {data.source.author && <> by {data.source.author.name}</>} · Published:{' '}
          <FormattedDate date={data.source.publishedDate} />
        </>
      )}
    </>
  ) : (
    <>Written by {data.author?.name ?? 'guog'}</>
  )}
</p>
<div class='flex flex-wrap items-center gap-x-3 gap-y-2'>
  <p class='font-semibold'>
    {data.contentKind === 'translation' ? 'Translation published: ' : 'Published: '}
    <FormattedDate date={data.pubDate} /> / {getReadingMinutes(post.body)} min read
  </p>
  {data.updatedDate && (
    <span class='bg-quote/5 text-quote rounded-lg px-2 py-1'>
      Updated: <FormattedDate date={data.updatedDate} />
    </span>
  )}
</div>
<span
  class='sr-only'
  data-markdown-exclude
  data-pagefind-filter='category'
>
  {data.category}
</span>
<p
  class='mt-4 text-muted'
  data-pagefind-meta='description'
>
  {data.description}
</p>
{data.tags.length > 0 && (
  <div class='mt-2'>
    <svg
      aria-hidden='true'
      class='inline-block h-6 w-6'
      fill='none'
      stroke='var(--color-muted)'
      stroke-width='1.5'
      viewBox='0 0 24 24'
    >
      <path d='M7.859 6H5.025A2.025 2.025 0 0 0 3 8.025v2.834c0 .537.213 1.052.593 1.432l6.116 6.116a2.025 2.025 0 0 0 2.864 0l2.834-2.834a2.025 2.025 0 0 0 0-2.864L9.29 6.593A2.025 2.025 0 0 0 7.859 6Z' />
      <path d='m17.573 18.407 2.834-2.834a2.025 2.025 0 0 0 0-2.864l-7.117-7.116M6 9h-.01' />
    </svg>
    {data.tags.map((tag, i) => (
      <span class='contents'>
        <a
          class='cactus-link inline-block'
          data-pagefind-filter={`tag:${tag}`}
          href={getTagUrl(tag)}
        >
          <span class='sr-only'>View more blogs with the tag </span>#{tag}
        </a>
        {i < data.tags.length - 1 && ', '}
      </span>
    ))}
  </div>
)}
