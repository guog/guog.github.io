---
import type { TocItem } from '../../utils/generateToc'

interface Props {
  heading: TocItem
  collapse?: boolean
}

const {
  heading: { children, depth, slug, text },
  collapse = false,
} = Astro.props
---

<li class={`${depth > 2 ? 'ms-2' : ''}`}>
  <a
    class={`line-clamp-2 hover:text-accent ${depth <= 2 ? 'mt-3' : 'mt-2 text-xs'}`}
    href={`#${slug}`}
  >
    <span
      aria-hidden='true'
      class='me-0.5'
    >
      #
    </span>
    {text}
  </a>
  {!!children.length && (
    <details open={!collapse}>
      <summary class='mt-2 cursor-pointer text-xs text-muted'>Subsections</summary>
      <ol>
        {children.map((subheading) => (
          <Astro.self
            heading={subheading}
            collapse={collapse}
          />
        ))}
      </ol>
    </details>
  )}
</li>
