---
import type { TocItem } from '../../utils/generateToc'

interface Props {
  heading: TocItem
}
const { children, slug, text } = Astro.props.heading
---

<li>
  <a href={`#${slug}`}>{text}</a>
  {children.length > 0 && (
    <ol>
      {children.map((heading) => (
        <Astro.self heading={heading} />
      ))}
    </ol>
  )}
</li>
