---
import type { CollectionEntry } from 'astro:content'
import { readingPrompt } from '../../utils/reading'
import { getPostUrl } from '../../utils/blog'
import { getMarkdownPath } from '../../utils/markdown'
interface Props {
  post: CollectionEntry<'blog'>
}
const { post } = Astro.props
---

<section
  class='agent-reading mt-6 border-y border-dashed border-muted py-4'
  aria-labelledby='agent-reading-title'
  data-markdown-exclude
  data-pagefind-ignore
>
  <h2
    id='agent-reading-title'
    class='font-semibold'
  >
    用自己的 Agent 对话阅读
  </h2>
  <p class='mt-2'>
    不必逐行读完。复制提示词，发给你自己的 Agent，通过对话理解文章；也可以继续向下阅读。
  </p>
  <div class='mt-3 flex flex-wrap items-center gap-4'>
    <button
      type='button'
      class='copy-prompt cactus-link'
      hidden
    >
      复制阅读提示词
    </button>
    <a
      class='cactus-link'
      href={getMarkdownPath(getPostUrl(post.id))}
    >
      Markdown
    </a>
  </div>
  <details class='mt-3'>
    <summary class='cursor-pointer'>查看提示词</summary>
    <textarea
      aria-label='阅读提示词'
      class='mt-2 block w-full rounded border border-muted bg-global-bg p-2 text-sm'
      rows={10}
      readonly
      spellcheck='false'
    >{readingPrompt(post.id, post.data)}</textarea>
  </details>
  <p
    class='copy-status mt-2 text-muted'
    role='status'
    aria-live='polite'
  ></p>
  <p class='mt-2 text-muted'>
    如果你的 Agent 无法访问网页，请保存 Markdown 文件提供给它，或粘贴正文；长文可按章节分次提供。
  </p>
</section>
<script>
  for (const section of document.querySelectorAll<HTMLElement>('.agent-reading')) {
    const button = section.querySelector<HTMLButtonElement>('.copy-prompt')!
    const textarea = section.querySelector<HTMLTextAreaElement>('textarea')!
    const details = section.querySelector('details')!
    const status = section.querySelector<HTMLElement>('.copy-status')!
    button.hidden = false
    button.addEventListener('click', async () => {
      status.textContent = ''
      button.disabled = true
      try {
        await navigator.clipboard.writeText(textarea.value)
        status.textContent = '已复制，粘贴到你的 Agent 即可。'
      } catch {
        details.open = true
        textarea.focus()
        textarea.select()
        status.textContent = '自动复制失败，请手动复制下方提示词。'
      } finally {
        button.disabled = false
      }
    })
  }
</script>
