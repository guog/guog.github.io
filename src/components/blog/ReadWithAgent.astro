---
import type { CollectionEntry } from 'astro:content'
import { readingPrompt } from '../../utils/reading'
import { getPostUrl } from '../../utils/blog'
import { getMarkdownPath } from '../../utils/markdown'
interface Props {
  post: CollectionEntry<'blog'>
}
const { post } = Astro.props
---

<section
  class='agent-reading mt-4 grid grid-cols-[8.5rem_minmax(0,1fr)] gap-x-2 text-muted'
  aria-label='用 Agent 阅读'
  data-markdown-exclude
  data-pagefind-ignore
>
  <details class='col-span-2 col-start-1 row-start-1'>
    <summary class='w-fit whitespace-nowrap'>用 Agent 阅读</summary>
    <div class='mt-3'>
      <p>将提示词粘贴到你的 Agent，开始对话阅读。</p>
      <textarea
        aria-label='阅读提示词'
        class='mt-2 block w-full rounded border border-muted bg-global-bg p-2 text-sm text-global-text'
        rows={10}
        readonly
        spellcheck='false'
      >{readingPrompt(post.id, post.data)}</textarea>
    </div>
  </details>
  <div class='col-start-2 row-start-1 flex flex-wrap items-baseline gap-x-3 gap-y-2 self-start'>
    <button
      type='button'
      class='copy-prompt cactus-link'
      hidden
    >
      复制提示词
    </button>
    <a
      class='cactus-link'
      href={getMarkdownPath(getPostUrl(post.id))}
    >
      Markdown
    </a>
  </div>
  <p
    class='copy-status col-span-2 text-muted empty:hidden'
    role='status'
    aria-live='polite'
  ></p>
</section>
<script>
  for (const section of document.querySelectorAll<HTMLElement>('.agent-reading')) {
    const button = section.querySelector<HTMLButtonElement>('.copy-prompt')!
    const textarea = section.querySelector<HTMLTextAreaElement>('textarea')!
    const details = section.querySelector('details')!
    const status = section.querySelector<HTMLElement>('.copy-status')!
    button.hidden = false
    button.addEventListener('click', async () => {
      status.textContent = ''
      button.disabled = true
      try {
        await navigator.clipboard.writeText(textarea.value)
        status.textContent = '已复制'
      } catch {
        details.open = true
        textarea.focus()
        textarea.select()
        status.textContent = '复制失败，请手动复制提示词。'
      } finally {
        button.disabled = false
      }
    })
  }
</script>
