---
import type { CollectionEntry } from 'astro:content'
import { getPostUrl } from '../../utils/blog'
import FormattedDate from '../FormattedDate.astro'
interface Props {
  post: CollectionEntry<'blog'>
  headingLevel?: 'h2' | 'h3' | 'div'
  id?: string
}
const { post, headingLevel: Heading = 'div', id } = Astro.props
---

<li
  id={id}
  class='grid gap-1 sm:grid-cols-[auto_1fr]'
>
  <FormattedDate date={post.data.pubDate} />
  <Heading class='min-w-0 font-normal'>
    <a
      class='cactus-link'
      href={getPostUrl(post.id)}
    >
      {post.data.title}
    </a>
  </Heading>
</li>
