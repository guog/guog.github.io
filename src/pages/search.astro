---
import Base from '../layouts/Base.astro'
---

<Base
  title='Search'
  description='Search all posts on this blog'
>
  <Fragment slot='head'>
    <link
      href='/pagefind/pagefind-ui.css'
      rel='stylesheet'
    />
  </Fragment>
  <h1 class='title'>Search</h1>
  <p class='mt-6 text-muted'>Search posts by topic or keyword.</p>
  <p class='mt-2'>
    Interactive search requires JavaScript. Browse <a href='/blog/'>all posts</a> instead.
  </p>
  <div id='search-page'></div>
  <noscript>
    Search requires JavaScript. Browse <a href='/blog/'>all posts</a> instead.
  </noscript>
  <script
    src='/pagefind/pagefind-ui.js'
    is:inline
  ></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (window.PagefindUI) {
        new window.PagefindUI({
          element: '#search-page',
          showSubResults: true,
          showImages: false,
          translations: {
            placeholder: 'Search posts',
            search_label: 'Search posts',
            clear_search: 'Clear',
            load_more: 'Load more results',
            filters_label: 'Filters',
            zero_results: 'No results for [SEARCH_TERM]',
            many_results: '[COUNT] results for [SEARCH_TERM]',
            one_result: '1 result for [SEARCH_TERM]',
            searching: 'Searching for [SEARCH_TERM]...',
            alt_search:
              'No results for [SEARCH_TERM]. Showing results for [DIFFERENT_TERM] instead.',
            search_suggestion: 'No results for [SEARCH_TERM]. Try one of the following searches:',
          },
        })
      } else
        document.getElementById('search-page').textContent =
          'Search is temporarily unavailable. Please browse all posts.'
    })
  </script>
</Base>
