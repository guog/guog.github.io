---
import PostPreview from '../../components/blog/PostPreview.astro'
import { getPublishedPosts } from '../../data/blog'
import Base from '../../layouts/Base.astro'
import { getTagUrl, getTaxonomyId } from '../../utils/blog'
const posts = await getPublishedPosts()
const years = [...new Set(posts.map((post) => post.data.pubDate.getUTCFullYear()))]
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) =>
  a.localeCompare(b, 'zh-CN'),
)
const firstInCategory = new Map(
  posts.map((post) => [
    post.data.category,
    posts.find((p) => p.data.category === post.data.category)!.id,
  ]),
)
---

<Base
  title='Posts'
  description='Read my collection of posts and the things that interest me'
>
  <div class='mb-12 flex items-center gap-3'>
    <h1 class='title'>Posts</h1>
    <a
      class='text-accent'
      href='/rss.xml'
      aria-label='RSS feed'
    >
      <svg
        class='h-6 w-6'
        aria-hidden='true'
        viewBox='0 0 24 24'
        fill='currentColor'
      >
        <path d='M6.18 15.64a2.18 2.18 0 1 0 0 4.36 2.18 2.18 0 0 0 0-4.36M4 4v3a13 13 0 0 1 13 13h3C20 11.16 12.84 4 4 4m0 6v3a7 7 0 0 1 7 7h3c0-5.52-4.48-10-10-10' />
      </svg>
    </a>
  </div>
  <div class='grid sm:grid-cols-[3fr_1fr] sm:gap-x-8 sm:gap-y-16'>
    <div>
      {years.map((year) => (
        <section class='mb-16'>
          <h2
            id={`year-${year}`}
            class='title text-lg'
          >
            <span class='sr-only'>Posts in </span>
            {year}
          </h2>
          <ul class='mt-5 space-y-4 text-start'>
            {posts
              .filter((post) => post.data.pubDate.getUTCFullYear() === year)
              .map((post) => (
                <PostPreview
                  post={post}
                  id={
                    firstInCategory.get(post.data.category) === post.id
                      ? getTaxonomyId('category', post.data.category)
                      : undefined
                  }
                />
              ))}
          </ul>
        </section>
      ))}
    </div>
    {tags.length > 0 && (
      <aside>
        <h2 class='title mb-4 flex items-center gap-1 text-lg'>
          <svg
            aria-hidden='true'
            class='h-6 w-6'
            fill='none'
            stroke='var(--color-muted)'
            stroke-width='1.5'
            viewBox='0 0 24 24'
          >
            <path d='M7.859 6H5.025A2.025 2.025 0 0 0 3 8.025v2.834c0 .537.213 1.052.593 1.432l6.116 6.116a2.025 2.025 0 0 0 2.864 0l2.834-2.834a2.025 2.025 0 0 0 0-2.864L9.29 6.593A2.025 2.025 0 0 0 7.859 6Z' />
            <path d='m17.573 18.407 2.834-2.834a2.025 2.025 0 0 0 0-2.864l-7.117-7.116M6 9h-.01' />
          </svg>
          Tags
        </h2>
        <ul class='flex flex-wrap gap-2'>
          {tags.map((tag) => (
            <li>
              <a
                id={getTaxonomyId('tag', tag)}
                class='cactus-link flex items-center justify-center'
                href={getTagUrl(tag)}
              >
                <span aria-hidden='true'>#</span>
                <span class='sr-only'>View all posts with the tag </span>
                {tag}
              </a>
            </li>
          ))}
        </ul>
        <span class='mt-4 block sm:text-end'>
          <a
            class='hover:text-link'
            href='/tags/'
          >
            View all <span aria-hidden='true'>→</span>
            <span class='sr-only'> blog tags</span>
          </a>
        </span>
      </aside>
    )}
  </div>
</Base>
