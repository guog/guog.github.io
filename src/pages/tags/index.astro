---
import { getPublishedPosts } from '../../data/blog'
import Base from '../../layouts/Base.astro'
import { getTagUrl } from '../../utils/blog'
const posts = await getPublishedPosts()
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) =>
  a.localeCompare(b, 'zh-CN'),
)
---

<Base
  title='All Tags'
  description='A list of all the topics I have written about in my posts'
>
  <h1 class='title mb-6'>Tags</h1>
  <ul class='space-y-4'>
    {tags.map((tag) => {
      const count = posts.filter((post) => post.data.tags.includes(tag)).length
      return (
        <li class='flex items-center gap-x-2'>
          <a
            class='cactus-link inline-block'
            href={getTagUrl(tag)}
            title={`View posts with the tag: ${tag}`}
          >
            #{tag}
          </a>
          <span>
            - {count} Post{count > 1 && 's'}
          </span>
        </li>
      )
    })}
  </ul>
</Base>
